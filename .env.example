# Core
POLYMARKET_BASE_URL=https://gateway.polymarket.us
SOURCE_CONFIG_PATH=config/sources.json
PAPER_BANKROLL=100
MAXIMUM_POSITION_FRACTION=0.05
MAXIMUM_TOTAL_EXPOSURE=5
MINIMUM_CONFIGURED_SOURCES=10
MINIMUM_SOURCE_FAMILIES=5
WATCHLIST_SOURCE_FAMILIES=3
MINIMUM_RAW_EDGE=0.05
MINIMUM_NET_EDGE=0.03
SCAN_LEASE_TTL_SECONDS=900
RUST_LOG=polybot=info

# Set only after a public endpoint and its use have passed review.
SOURCE_PINNACLE_URL=
SOURCE_CIRCA_URL=
SOURCE_BOOKMAKER_URL=
SOURCE_BETONLINE_URL=
SOURCE_BET365_URL=
SOURCE_DRAFTKINGS_URL=
SOURCE_FANDUEL_URL=
SOURCE_CAESARS_URL=
SOURCE_BETMGM_URL=
SOURCE_FANATICS_URL=

# Optional fallbacks.
SOURCE_BETRIVERS_URL=
SOURCE_HARDROCK_URL=
SOURCE_THESCORE_URL=

# Quota-limited validation only. Disabled by default.
ENABLE_THE_ODDS_API_VALIDATOR=false
THE_ODDS_API_KEY=

# Local API.
DATA_DIR=data
LISTEN_ADDRESS=127.0.0.1:8080
