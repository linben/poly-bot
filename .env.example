# Core
# local (default): file store, in-process news loop and terminal UI.
# cloud: S3/DynamoDB/SQS store; requires a build with --features aws.
RUN_MODE=local
POLYMARKET_BASE_URL=https://gateway.polymarket.us
SOURCE_CONFIG_PATH=config/sources.json
SCAN_INTERVAL_SECONDS=300
DISCOVERY_REFRESH_SECONDS=900
POLYMARKET_CONCURRENCY=8
LOCAL_RETENTION_DAYS=14

# News review: keyword (needs BRAVE_SEARCH_API_KEY), bedrock, off, or unset.
NEWS_REVIEWER=
BRAVE_SEARCH_API_KEY=
NEWS_REFRESH_SECONDS=3600
PAPER_BANKROLL=100
MAXIMUM_POSITION_FRACTION=0.05
MAXIMUM_TOTAL_EXPOSURE=5
# Distinct continuous source families required at startup (>= 3).
MINIMUM_CONFIGURED_SOURCES=3
MINIMUM_SOURCE_FAMILIES=5
WATCHLIST_SOURCE_FAMILIES=3
MINIMUM_RAW_EDGE=0.05
MINIMUM_NET_EDGE=0.03
SCAN_LEASE_TTL_SECONDS=900
# RUST_LOG=info (default; HTTP client internals are muted)

# Built-in public continuous sources (no keys). Set to false to disable one.
ENABLE_ESPN_ODDS=true
ENABLE_KALSHI=true
ENABLE_POLYMARKET_GLOBAL=true
# Polymarket global markets below this liquidity (USD) are ignored.
POLYMARKET_GLOBAL_MIN_LIQUIDITY=2000
# ...and below this traded volume (USD); untraded market-maker seeds sit at 50/50.
POLYMARKET_GLOBAL_MIN_VOLUME=250

# Confirmation tier: The Odds API free plan (500 credits/month). Queried only
# when the continuous sources produce a candidate; adds ~10 book families
# including Pinnacle, which is what makes an actionable result possible.
ENABLE_THE_ODDS_API=false
THE_ODDS_API_KEY=
THE_ODDS_API_REGIONS=us,eu
THE_ODDS_API_MIN_REMAINING=40
THE_ODDS_API_INCLUDE_TENNIS=false

# Direct canonical-JSON adapters. Set only after a public endpoint and its use
# have passed review.
SOURCE_PINNACLE_URL=
SOURCE_CIRCA_URL=
SOURCE_BOOKMAKER_URL=
SOURCE_BETONLINE_URL=
SOURCE_BET365_URL=
SOURCE_DRAFTKINGS_URL=
SOURCE_FANDUEL_URL=
SOURCE_CAESARS_URL=
SOURCE_BETMGM_URL=
SOURCE_FANATICS_URL=
SOURCE_BETRIVERS_URL=
SOURCE_HARDROCK_URL=
SOURCE_THESCORE_URL=

# Local store directory (used by local, tui and paper). The terminal UI is
# `make tui` (cargo run --bin tui); `local` opens it in-process on a TTY.
DATA_DIR=data
