# Core
# local (default): file store, in-process news loop and terminal UI.
# cloud: S3/DynamoDB/SQS store; requires a build with --features aws.
RUN_MODE=local
POLYMARKET_BASE_URL=https://gateway.polymarket.us
SOURCE_CONFIG_PATH=config/sources.json
SCAN_INTERVAL_SECONDS=300
DISCOVERY_REFRESH_SECONDS=900
POLYMARKET_CONCURRENCY=8
SOURCE_CONCURRENCY=4
LOCAL_RETENTION_DAYS=14

# News review: keyword (needs EXA_API_KEY), bedrock, off, or unset (no
# evidence; candidates stay on the watchlist). Exa: POST api.exa.ai/search,
# eight results with highlights, no date filter (see README.md).
NEWS_REVIEWER=
EXA_API_KEY=
# bedrock only: build with --features aws, AWS credentials in the environment.
BEDROCK_MODEL_ID=
# Evidence newer than this is reused instead of searching again.
NEWS_REFRESH_SECONDS=3600

# Gates. Defaults are the policy in README.md; `make local-explore` runs the
# loosest values validation permits (raw 0.01, net 0, position floor 0, price
# 0.10-0.90, quorum 1/2, no reference book) into a separate data dir.
PAPER_BANKROLL=100
# Sides sized below this fraction of bankroll are rejected; 0 disables.
MINIMUM_POSITION_FRACTION=0.01
MAXIMUM_POSITION_FRACTION=0.05
MAXIMUM_TOTAL_EXPOSURE=5
# Cap across every market of one event (<= total exposure).
MAXIMUM_EVENT_EXPOSURE=2.5
# Kelly multiplier applied to the conservative probability (0 < f <= 1).
KELLY_FRACTION=0.25
# Distinct continuous source families required at startup (>= watchlist quorum).
MINIMUM_CONFIGURED_SOURCES=3
# Families for actionable (>= watchlist) and watchlist (>= 1; 1 is a single venue, not consensus).
MINIMUM_SOURCE_FAMILIES=5
WATCHLIST_SOURCE_FAMILIES=3
# Actionable also needs a reference sportsbook (Pinnacle-class) in consensus.
REQUIRE_REFERENCE_BOOK=true
MINIMUM_RAW_EDGE=0.05
MINIMUM_NET_EDGE=0.03
# Subtracted from the backed side's consensus probability before net edge and
# sizing. Bookmaker consensus over-states the outcome you back by a roughly
# constant intercept (~0.035 measured on football closing odds); raw edge is
# reported without it.
CONSENSUS_BIAS=0.02
# Executable contract price band.
MINIMUM_PRICE=0.35
MAXIMUM_PRICE=0.65
# Markets starting sooner than this are not actionable; lineups move prices
# faster than a five-minute scan follows.
MINIMUM_LEAD_MINUTES=15
# Kalshi / Polymarket global quotes leave the consensus for games further out
# than this; exchange prices are calibrated 0.5-4 h before close, not days out.
EXCHANGE_MAX_LEAD_HOURS=4
# Freshness windows: preliminary quotes, refetched confirmation quotes, books.
MAX_QUOTE_AGE_SECONDS=360
CONFIRMATION_MAX_AGE_SECONDS=90
BOOK_MAX_AGE_SECONDS=15
# Venue fee schedule: makers receive 0.0125 * p * (1 - p) per contract. Only
# used to report the maker edge alongside the taker edge.
MAKER_REBATE_COEFFICIENT=0.0125
# Public gateway limit is 20 requests/second/IP; book and settlement requests
# are paced to this.
POLYMARKET_REQUESTS_PER_SECOND=18
# How often open paper positions are checked for a closing line / settlement.
SETTLEMENT_POLL_SECONDS=600
SCAN_LEASE_TTL_SECONDS=900
# RUST_LOG=info (default; HTTP client internals are muted)

# Built-in public continuous sources (no keys). Set to false to disable one.
ENABLE_PINNACLE=true
ENABLE_ACTION_NETWORK=true
ENABLE_ESPN_ODDS=true
ENABLE_KALSHI=true
ENABLE_POLYMARKET_GLOBAL=true
ENABLE_SMARKETS=true
# Base URL overrides: PINNACLE_BASE_URL, PINNACLE_GUEST_API_KEY (public web key),
# ACTION_NETWORK_BASE_URL, SMARKETS_BASE_URL, ESPN_BASE_URL, KALSHI_BASE_URL,
# POLYMARKET_GAMMA_BASE_URL.
# Polymarket global markets below this liquidity (USD) are ignored.
POLYMARKET_GLOBAL_MIN_LIQUIDITY=2000
# ...and below this traded volume (USD); untraded market-maker seeds sit at 50/50.
POLYMARKET_GLOBAL_MIN_VOLUME=250

# Confirmation tier: The Odds API free plan (500 credits/month). Queried only
# when the continuous sources produce a candidate; adds ~10 book families
# including Pinnacle, which is what makes an actionable result possible.
ENABLE_THE_ODDS_API=false
THE_ODDS_API_KEY=
THE_ODDS_API_REGIONS=us,eu
THE_ODDS_API_MIN_REMAINING=40
THE_ODDS_API_INCLUDE_TENNIS=false

# Direct canonical-JSON adapters. Set only after a public endpoint and its use
# have passed review.
SOURCE_PINNACLE_URL=
SOURCE_CIRCA_URL=
SOURCE_BOOKMAKER_URL=
SOURCE_BETONLINE_URL=
SOURCE_BET365_URL=
SOURCE_DRAFTKINGS_URL=
SOURCE_FANDUEL_URL=
SOURCE_CAESARS_URL=
SOURCE_BETMGM_URL=
SOURCE_FANATICS_URL=
SOURCE_BETRIVERS_URL=
SOURCE_HARDROCK_URL=
SOURCE_THESCORE_URL=

# Local store directory (used by local, tui and paper). The terminal UI is
# `make tui` (cargo run --bin tui); `local` opens it in-process on a TTY.
DATA_DIR=data
